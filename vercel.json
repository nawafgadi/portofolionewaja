{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{**/*.png,**/*.jpg,**/*.jpeg,**/*.jfif,**/*.gif,**/*.webp,**/*.mp4,__pycache__/**}"
    }
  }
}